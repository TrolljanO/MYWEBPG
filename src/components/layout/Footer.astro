---
import Arrow from '../ui/Arrow.astro';
import { site } from '../../config/site';
import { withBase } from '../../lib/paths';

const linkedIn = site.socials.find((item) => item.label === 'LinkedIn');
const otherSocials = site.socials.filter((item) => item !== linkedIn);
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <p class="footer-name">
          O que você
          <br />
          está construindo?
        </p>
        <p class="muted">Desenvolvimento, dados e inteligência artificial.</p>
      </div>
      <div>
        {linkedIn && (
          <a class="button primary" href={linkedIn.href}>
            {linkedIn.label} <Arrow direction="up-right" />
          </a>
        )}
        {otherSocials.map((s) => (
          <a href={s.href}>
            {s.label} <Arrow direction="up-right" />
          </a>
        ))}
        {site.email && <a href={`mailto:${site.email}`}>E-mail</a>}
      </div>
    </div>
    <div class="footer-bottom meta">
      <span>© {new Date().getFullYear()} Guilherme Trajano</span>
      <nav aria-label="Rodapé">
        <a href={withBase('resume/')}>Currículo</a>
        <a href={withBase('rss.xml')}>RSS</a>
        <a href={withBase('privacy/')}>Privacidade</a>
        <a href="#top">
          Voltar ao topo <Arrow direction="up" />
        </a>
      </nav>
    </div>
  </div>
</footer>
