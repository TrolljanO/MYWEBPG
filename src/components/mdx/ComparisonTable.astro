---
interface Props {
  headers: string[];
  rows: string[][];
  caption: string;
}
const { headers, rows, caption } = Astro.props;
---

<table>
  <caption>{caption}</caption>
  <thead>
    <tr>
      {headers.map((h) => (
        <th scope="col">{h}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        {row.map((cell) => (
          <td>{cell}</td>
        ))}
      </tr>
    ))}
  </tbody>
</table>
