<div class="hero-art" data-hero-scene>
  <svg viewBox="0 0 500 500" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2">
      <path d="M250 70 420 170 420 330 250 430 80 330 80 170Z M250 70V430 M80 170 250 270 420 170 M80 330 250 230 420 330 M250 70 80 330H420Z M250 430 80 170H420Z" />
      <circle cx="250" cy="250" r="180" stroke-dasharray="3 8" />
      <circle cx="250" cy="250" r="120" />
      <path d="M20 250H480M250 20V480" opacity=".4" />
    </g>
  </svg>
  <span class="art-label" aria-hidden="true">
    ESTUDO ESPACIAL / 3D
  </span>
  <button class="motion-toggle" type="button" hidden aria-pressed="false">
    Pausar movimento
  </button>
</div>
<script>
  const host = document.querySelector<HTMLElement>('[data-hero-scene]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection?.saveData;
  if (host && !reduced.matches && !saveData) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          const start = () => {
            if (!reduced.matches)
              void import('../../lib/three/hero-scene')
                .then((m) => m.mountHero(host))
                .catch(() => {
                  host.dataset.ready = 'false';
                });
          };
          if ('requestIdleCallback' in window)
            window.requestIdleCallback(start, { timeout: 2000 });
          else setTimeout(start, 500);
        }
      },
      { rootMargin: '100px' },
    );
    observer.observe(host);
  }
</script>
