---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Layer {
  src: ImageMetadata;
  depth: number;
}
interface Props {
  layers: Layer[];
  caption: string;
  note: string;
  label: string;
  loading: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
  variant?: 'full';
  sizes?: string;
}
const { layers, caption, note, label, loading, decoding, variant, sizes } =
  Astro.props;
const stage = layers[0].src;
// Chromium drops a percentage inside sizes and then fetches the largest file.
const imageSizes =
  sizes ??
  (variant === 'full'
    ? 'min(100vw, calc(100svh - 5.5rem))'
    : 'min(100vw, calc((100svh - 5.5rem) * 1.5))');
const stageStyle = `--ar-w:${stage.width};--ar-h:${stage.height}`;
const figureClass = variant === 'full' ? 'diorama diorama--full' : 'diorama';
---

<figure class={figureClass} data-diorama>
  <div class="diorama-stage" data-stage style={stageStyle}>
    {layers.map((layer) => (
      <div
        class="diorama-plane"
        data-depth={layer.depth}
        style={`--depth:${layer.depth}`}
      >
        <div class="diorama-shift">
          <Image
            src={layer.src}
            alt=""
            widths={[480, 828, 1248, 2400]}
            sizes={imageSizes}
            loading={loading}
            decoding={decoding}
          />
        </div>
      </div>
    ))}
  </div>
  <figcaption>
    <span>{caption}</span>
    <span class="muted">{note}</span>
  </figcaption>
  <button class="motion-toggle" type="button" hidden aria-pressed="false">
    Pausar movimento
  </button>
  <p class="sr-only">{label}</p>
</figure>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection?.saveData;
  const quiet = reduced.matches || saveData;
  for (const host of document.querySelectorAll<HTMLElement>(
    '[data-diorama]:not([data-bound])',
  )) {
    host.setAttribute('data-bound', '');
    if (quiet) host.setAttribute('data-paused', '');
    const button = host.querySelector<HTMLButtonElement>('.motion-toggle');
    if (!button || quiet) continue;
    button.hidden = false;
    const stage = host.querySelector<HTMLElement>('[data-stage]');
    const planes = [...host.querySelectorAll<HTMLElement>('[data-depth]')];
    const place = (x: number, y: number) => {
      for (const plane of planes) {
        const depth = Number(plane.dataset.depth);
        const shift = plane.querySelector<HTMLElement>('.diorama-shift');
        if (!shift) continue;
        shift.style.translate = `${(x * depth * 7).toFixed(1)}px ${(y * depth * 5).toFixed(1)}px`;
      }
    };
    stage?.addEventListener('pointermove', (event) => {
      if (host.hasAttribute('data-paused') || !stage) return;
      const rect = stage.getBoundingClientRect();
      place(
        (event.clientX - rect.left) / rect.width - 0.5,
        (event.clientY - rect.top) / rect.height - 0.5,
      );
    });
    stage?.addEventListener('pointerleave', () => {
      if (!host.hasAttribute('data-paused')) place(0, 0);
    });
    button.addEventListener('click', () => {
      const pausing = !host.hasAttribute('data-paused');
      for (const other of document.querySelectorAll<HTMLElement>(
        '[data-diorama]',
      )) {
        other.toggleAttribute('data-paused', pausing);
        const otherButton =
          other.querySelector<HTMLButtonElement>('.motion-toggle');
        if (otherButton && !otherButton.hidden) {
          otherButton.setAttribute('aria-pressed', String(pausing));
          otherButton.textContent = pausing
            ? 'Retomar movimento'
            : 'Pausar movimento';
        }
        if (!pausing) continue;
        other
          .querySelectorAll<HTMLElement>('.diorama-shift')
          .forEach((shift) => {
            shift.style.translate = '0px 0px';
          });
      }
    });
  }
</script>
