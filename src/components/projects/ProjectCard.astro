---
import Arrow from '../ui/Arrow.astro';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
---

<article class="project-card">
  <div>
    <p class="meta">{project.data.status}</p>
    <h3>
      <a href={withBase(`projects/${project.id}/`)}>
        {project.data.title} <Arrow direction="up-right" />
      </a>
    </h3>
  </div>
  <p class="muted">{project.data.summary}</p>
  <div class="meta">{project.data.tags.join(' / ')}</div>
</article>
