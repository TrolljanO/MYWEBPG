---
interface Props {
  direction?: 'up-right' | 'left' | 'right' | 'up';
}
const rotations = { 'up-right': 0, left: 225, right: 45, up: -45 };
const { direction = 'up-right' } = Astro.props;
---

<svg
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  style={`display:inline-block;vertical-align:middle;flex-shrink:0;transform:rotate(${rotations[direction]}deg)`}
>
  <path d="M5 19 19 5M5 5h14v14" />
</svg>
