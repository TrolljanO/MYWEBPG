---
import '../styles/global.css';
import cormorant from '../assets/fonts/cormorant-500.woff2';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '../components/layout/Analytics.astro';
import { site } from '../config/site';
import { withBase, absolute } from '../lib/paths';
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  canonicalUrl,
  image = absolute('og.png'),
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const structured = jsonLd || {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: absolute(),
  sameAs: site.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={cormorant}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Artigos de Guilherme Trajano"
      href={withBase('rss.xml')}
    />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${title} | ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\u003c')}
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light')
          document.documentElement.dataset.theme = t;
      } catch {
        /* Storage may be unavailable. */
      }
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
