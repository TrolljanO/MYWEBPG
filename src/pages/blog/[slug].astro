---
import Arrow from '../../components/ui/Arrow.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/BaseLayout.astro';
import ReadingTools from '../../components/blog/ReadingTools.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { posts } from '../../lib/content';
import { withBase, absolute, tagPath } from '../../lib/paths';
import { formatDate, readingTime, related } from '../../lib/editorial';
import { site } from '../../config/site';
export async function getStaticPaths() {
  const all = await posts();
  return all.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      older: all[index + 1],
      newer: all[index - 1],
      relatedPosts: related(post, all),
    },
  }));
}
const { post, older, newer, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const canonical = data.canonicalUrl || absolute(`blog/${post.id}/`);
const image = data.cover
  ? new URL(data.cover.src.src, Astro.site).href
  : absolute('og.png');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description,
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate || data.pubDate).toISOString(),
      author: { '@type': 'Person', name: site.name, url: absolute('about/') },
      url: canonical,
      mainEntityOfPage: canonical,
      image,
      keywords: data.tags,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: absolute() },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: absolute('blog/'),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: data.title,
          item: canonical,
        },
      ],
    },
  ],
};
---

<Base
  title={data.title}
  description={data.description}
  canonicalUrl={canonical}
  image={image}
  type="article"
  publishedTime={data.pubDate.toISOString()}
  jsonLd={jsonLd}
  surface="blog"
>
  <div class="wrap section">
    <article class="reading">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase()}>Início</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('blog/')}>Blog</a>
      </nav>
      <header>
        <p class="meta">
          <time datetime={data.pubDate.toISOString()}>
            {formatDate(data.pubDate)}
          </time>{' '}
          · {data.readingTime || readingTime(post.body)} min de leitura
        </p>
        <h1>{data.title}</h1>
        <p class="lead">{data.description}</p>
        {data.updatedDate && (
          <p class="meta">
            Atualizado em{' '}
            <time datetime={data.updatedDate.toISOString()}>
              {formatDate(data.updatedDate)}
            </time>
          </p>
        )}
        <div class="tags">
          {data.tags.map((t) => (
            <a class="tag" href={tagPath(t)}>
              {t}
            </a>
          ))}
        </div>
      </header>
      {data.cover && (
        <Image
          class="cover"
          src={data.cover.src}
          alt={data.cover.alt}
          widths={[400, 800, 1200]}
          sizes="(max-width:800px) 90vw, 72ch"
          loading="eager"
        />
      )}
      {data.toc && headings.filter((h) => h.depth === 2).length >= 3 && (
        <nav class="toc" aria-label="Neste artigo">
          <strong>Neste artigo</strong>
          <ul>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
          </ul>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
      {data.social.length > 0 && (
        <aside class="toc">
          <h2>Também nas redes</h2>
          <ul>
            {data.social.map((s) => (
              <li>
                <a href={s.url}>
                  Versão no {s.platform} <Arrow direction="up-right" />
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
      <div class="actions">
        <a
          class="button"
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
        >
          Compartilhar no LinkedIn
        </a>
        <a
          class="button"
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(data.title)}`}
        >
          Compartilhar no X
        </a>
      </div>
      <nav class="pagination" aria-label="Outros artigos">
        {older && (
          <a href={withBase(`blog/${older.id}/`)}>
            <Arrow direction="left" /> {older.data.title}
          </a>
        )}
        {newer && (
          <a href={withBase(`blog/${newer.id}/`)}>
            {newer.data.title} <Arrow direction="right" />
          </a>
        )}
      </nav>
    </article>
    {relatedPosts.length > 0 && (
      <section class="section">
        <h2>Continue a leitura.</h2>
        <div class="post-grid">
          {relatedPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}
  </div>
  <ReadingTools />
</Base>
