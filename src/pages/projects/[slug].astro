---
import Arrow from '../../components/ui/Arrow.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/BaseLayout.astro';
import ReadingTools from '../../components/blog/ReadingTools.astro';
import { projects } from '../../lib/content';
import { withBase, absolute, tagPath } from '../../lib/paths';
import { formatDate } from '../../lib/editorial';
import { site } from '../../config/site';
export async function getStaticPaths() {
  const entries = await projects();
  return entries.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: entries[index + 1] },
  }));
}
const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const pageUrl = absolute(`projects/${project.id}/`);
const image = data.cover
  ? new URL(data.cover.src.src, Astro.site).href
  : absolute('og.png');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: data.title,
      description: data.description || data.summary,
      url: pageUrl,
      author: { '@type': 'Person', name: site.name },
      dateCreated: data.startDate.toISOString(),
      keywords: data.tags,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: absolute() },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Projetos',
          item: absolute('projects/'),
        },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
---

<Base
  title={data.title}
  description={data.description || data.summary}
  image={image}
  type="website"
  jsonLd={jsonLd}
>
  <div class="wrap section">
    <article class="reading">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase()}>Início</a>
        <span>/</span>
        <a href={withBase('projects/')}>Projetos</a>
      </nav>
      <p class="meta">{data.status}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <p class="meta">
        {formatDate(data.startDate)}
        {data.endDate && ` a ${formatDate(data.endDate)}`}
        {data.role && ` · ${data.role}`}
      </p>
      <div class="tags">
        {data.tags.map((t) => (
          <a class="tag" href={tagPath(t, 'projects')}>
            {t}
          </a>
        ))}
      </div>
      {data.cover && (
        <Image
          class="cover"
          src={data.cover.src}
          alt={data.cover.alt}
          widths={[400, 800, 1200]}
          sizes="(max-width:800px) 90vw, 72ch"
        />
      )}
      {data.metrics.length > 0 && (
        <dl class="two-col toc">
          {data.metrics.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )}
      <div class="prose">
        <Content />
      </div>
      <div class="actions">
        {data.repository && (
          <a class="button" href={data.repository}>
            Repositório <Arrow direction="up-right" />
          </a>
        )}
        {data.liveUrl && (
          <a class="button" href={data.liveUrl}>
            Ver projeto <Arrow direction="up-right" />
          </a>
        )}
      </div>
      {next && (
        <a class="button" href={withBase(`projects/${next.id}/`)}>
          Próximo projeto: {next.data.title} <Arrow direction="right" />
        </a>
      )}
    </article>
  </div>
  <ReadingTools />
</Base>
