---
import Base from '../layouts/BaseLayout.astro';
import { Content } from '../content/pages/resume.md';
---

<Base
  title="Currículo"
  description="Currículo e competências de Guilherme Trajano."
>
  <div class="wrap section">
    <article class="reading">
      <h1>Currículo.</h1>
      <button class="button print-button" type="button" hidden>
        Imprimir / salvar PDF
      </button>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Base>
<script>
  const button = document.querySelector<HTMLButtonElement>('.print-button')!;
  button.hidden = false;
  button.addEventListener('click', () => window.print());
</script>
